{
  "name": "backend",
  "version": "1.0.0",
  "description": "Node.js Express backend with Prisma and PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
