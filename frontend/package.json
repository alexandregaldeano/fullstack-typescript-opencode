{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:translations": "node scripts/lint-translations.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@fullstack/shared": "*",
    "i18next": "^25.4.2",
    "i18next-browser-languagedetector": "^8.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.3.0"
  },

  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.0.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "serve": "^14.2.6",
    "vite": "^7.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,css}": [
      "eslint --fix"
    ]
  },
  "resolutions": {
    "vitest/vite": "^7.0.0"
  }
}
