{
  "name": "fullstack-typescript-opencode",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "husky:setup": "git config core.hooksPath .husky",
    "build": "yarn workspace @fullstack/shared build && yarn workspace backend build && yarn workspace frontend build",
    "typecheck": "yarn workspace @fullstack/shared typecheck && yarn workspace backend typecheck && yarn workspace frontend typecheck",
    "lint": "yarn workspace backend lint && yarn workspace frontend lint",
    "lint:fix": "yarn workspace backend lint:fix && yarn workspace frontend lint:fix",
    "test": "yarn workspace backend test && yarn workspace frontend test",
    "test:run": "yarn workspace backend test:run && yarn workspace frontend test:run",
    "prisma:generate": "yarn workspace backend prisma:generate",
    "prisma:migrate:deploy": "yarn workspace backend prisma:migrate",
    "typecheck:backend": "yarn workspace backend typecheck",
    "lint:backend": "yarn workspace backend lint",
    "lint:backend:fix": "yarn workspace backend lint:fix",
    "test:run:backend": "yarn workspace backend test:run",
    "typecheck:frontend": "yarn workspace frontend typecheck",
    "lint:frontend": "yarn workspace frontend lint",
    "lint:frontend:fix": "yarn workspace frontend lint:fix",
    "lint:translations": "yarn workspace frontend lint:translations",
    "test:run:frontend": "yarn workspace frontend test:run"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
