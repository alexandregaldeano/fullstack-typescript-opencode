{
  "name": "fullstack-typescript-opencode",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "cd backend && tsx watch src/index.ts",
    "dev:frontend": "cd frontend && vite",
    "dev": "concurrently \"yarn dev:backend\" \"yarn dev:frontend\"",
    "build:backend": "cd backend && tsc",
    "build:frontend": "cd frontend && tsc && vite build",
    "build": "yarn build:backend && yarn build:frontend",
    "start:backend": "cd backend && node dist/index.js",
    "preview:frontend": "cd frontend && vite preview",
    "prisma:generate": "cd backend && prisma generate",
    "prisma:migrate": "cd backend && prisma migrate dev",
    "prisma:migrate:deploy": "cd backend && prisma migrate deploy",
    "prisma:studio": "cd backend && prisma studio",
    "lint:backend": "cd backend && eslint .",
    "lint:frontend": "cd frontend && eslint .",
    "lint": "yarn lint:backend && yarn lint:frontend && yarn lint:translations",
    "lint:fix:backend": "cd backend && eslint . --fix",
    "lint:fix:frontend": "cd frontend && eslint . --fix",
    "lint:fix": "yarn lint:fix:backend && yarn lint:fix:frontend",
    "lint:translations": "tsx scripts/lint-translations.ts",
    "typecheck:backend": "cd backend && tsc --noEmit",
    "typecheck:frontend": "cd frontend && tsc --noEmit",
    "typecheck": "yarn typecheck:backend && yarn typecheck:frontend",
    "test:backend": "cd backend && vitest",
    "test:frontend": "cd frontend && vitest",
    "test": "vitest",
    "test:run:backend": "cd backend && vitest run",
    "test:run:frontend": "cd frontend && vitest run",
    "test:run": "vitest run",
    "husky:setup": "git config core.hooksPath .husky"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^4.21.0",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.0.0",
    "swagger-jsdoc": "^6.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^6.0.2",
    "@types/helmet": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.2",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prisma": "^6.0.0",
    "serve": "^14.2.6",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "backend/*.{ts,tsx,js}": [
      "eslint --fix",
      "tsc --noEmit"
    ],
    "frontend/*.{ts,tsx,js,css}": [
      "eslint --fix"
    ]
  }
}
